# --- Canonical redirects ---
# /index.html -> / so we don't have duplicate canonicals indexed.
# 20i terminates SSL at the LB so %{HTTPS} doesn't reflect the real request
# protocol; we rely on 20i's built-in HTTPS+www canonicalisation for those
# rather than custom rules (previous attempt at combined HTTPS/www caused
# a self-redirect loop on / because %{HTTPS} was always "off" at Apache).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html(\?.*)?\ HTTP
  RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

# --- Legacy URL redirects ---
# Old generic migration page (still ghost-indexed by Google but returns 404).
# Consolidated into the per-competitor compare-* pages; redirect to compare hub.
Redirect 301 /home-care-software-migration.html /compare.html

# --- Security headers ---
<IfModule mod_headers.c>
  # HSTS — force HTTPS for 1 year, include subdomains, preload-eligible
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Prevent clickjacking via iframe embedding
  Header always set X-Frame-Options "SAMEORIGIN"

  # Block MIME type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Limit referrer info leakage cross-origin
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Disable browser features the site doesn't use (camera, mic, geo, payment, etc.)
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"

  # Cross-origin policies — allow embeddable resources but block evil cross-origin reads
  Header always set X-XSS-Protection "0"
</IfModule>

# Cache Control
<IfModule mod_expires.c>
  ExpiresActive On

  # Images — 1 year (immutable after deploy)
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg  "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/gif  "access plus 1 year"

  # CSS/JS — 1 day, revalidate in background
  ExpiresByType text/css   "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"

  # HTML — always revalidate
  ExpiresByType text/html  "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Images
  <FilesMatch "\.(webp|png|jpe?g|gif|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # CSS/JS
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  </FilesMatch>

  # HTML
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Enable Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain
</IfModule>

# Pretty URLs — map /onboard to /onboard.html, etc.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # If the request doesn't map to a real file or directory...
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  # ...and appending .html resolves to a real file, rewrite to it
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
