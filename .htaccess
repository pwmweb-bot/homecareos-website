# --- Canonical host + redirects ---
# 20i terminates SSL at the LB, so %{HTTPS} reads "off" at Apache and any rule
# that branches on it self-redirect-loops. We avoid %{HTTPS} entirely:
#   - the host rule matches only the bare apex (Host header passes through the
#     LB intact) and hardcodes the https://www target, so it fires at most once
#     and can't loop.
#   - every redirect target below is an absolute https://www URL, which also
#     fixes the previous insecure http:// Location hop the mod_alias `Redirect`
#     directive emitted (Apache built it from its wrong notion of scheme).
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host: non-www apex -> www (single hop, hardcoded https, loop-safe)
  RewriteCond %{HTTP_HOST} ^homecareos\.co\.uk$ [NC]
  RewriteRule ^(.*)$ https://www.homecareos.co.uk/$1 [R=301,L]

  # /index.html -> / (absolute target so it can't land on http:// or non-www)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html(\?.*)?\ HTTP
  RewriteRule ^index\.html$ https://www.homecareos.co.uk/ [R=301,L]

  # --- Legacy URL redirects (explicit https://www targets — no insecure hop) ---
  # Old generic migration page (ghost-indexed, returns 404). -> compare hub.
  RewriteRule ^home-care-software-migration\.html$ https://www.homecareos.co.uk/compare.html [R=301,L]

  # Old onboarding landing (duplicate of /start.html, weaker copy). -> /start.html.
  RewriteRule ^onboard\.html$ https://www.homecareos.co.uk/start.html [R=301,L]
  RewriteRule ^onboard/?$ https://www.homecareos.co.uk/start.html [R=301,L]
</IfModule>

# --- Security headers ---
<IfModule mod_headers.c>
  # HSTS — force HTTPS for 1 year, include subdomains, preload-eligible
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Prevent clickjacking via iframe embedding
  Header always set X-Frame-Options "SAMEORIGIN"

  # Block MIME type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Limit referrer info leakage cross-origin
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Disable browser features the site doesn't use (camera, mic, geo, payment, etc.)
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"

  # Cross-origin policies — allow embeddable resources but block evil cross-origin reads
  Header always set X-XSS-Protection "0"
</IfModule>

# Cache Control
<IfModule mod_expires.c>
  ExpiresActive On

  # Images — 1 year (immutable after deploy)
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg  "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/gif  "access plus 1 year"

  # CSS/JS — 1 day, revalidate in background
  ExpiresByType text/css   "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"

  # HTML — always revalidate
  ExpiresByType text/html  "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Images
  <FilesMatch "\.(webp|png|jpe?g|gif|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # CSS/JS
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  </FilesMatch>

  # HTML
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Enable Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain
</IfModule>

# Pretty URLs — map /onboard to /onboard.html, etc.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # If the request doesn't map to a real file or directory...
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  # ...and appending .html resolves to a real file, rewrite to it
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
